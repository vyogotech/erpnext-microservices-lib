# Copy to .env and adjust. Every value here is a default or a placeholder —
# there are no real credentials in this file.

# ---------------------------------------------------------------------------
# Site / database
# ---------------------------------------------------------------------------
FRAPPE_SITE=dev.localhost
FRAPPE_SITES_PATH=/app/sites
DB_HOST=central-site
REDIS_HOST=central-site
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Central Site — the authentication authority this service validates against.
# ---------------------------------------------------------------------------
CENTRAL_SITE_URL=http://central-site:8000
CENTRAL_SITE_API_KEY=
CENTRAL_SITE_API_SECRET=
CENTRAL_SITE_USER=
CENTRAL_SITE_PASSWORD=
CENTRAL_SITE_TIMEOUT=10

# ---------------------------------------------------------------------------
# Tenancy
#
# MULTI_TENANT=1 (the default) scopes every read and write by tenant_id, and
# requires a Central Site tenancy provider that puts a tenant_id column on the
# tables and exposes it in session validation.
#
# MULTI_TENANT=0 turns that off entirely and runs against a stock
# Frappe/ERPNext site. Note an EMPTY value is NOT off — it falls back to the
# default so a missing ConfigMap key cannot silently drop isolation. Use "0".
# ---------------------------------------------------------------------------
MULTI_TENANT=1

# off | warn | enforce. Only meaningful when MULTI_TENANT=1.
TENANT_STRICT=warn

# ---------------------------------------------------------------------------
# Security policy modes: off | warn | enforce.
# These ship as "warn" (log-only) and become "enforce" by default in 2.0.
# ---------------------------------------------------------------------------
PERMISSION_MODE=warn
CSRF_MODE=warn
MASK_PERMISSION_ERRORS=0

# Comma-separated origins allowed for CORS.
ALLOW_CORS=https://example.test

# ---------------------------------------------------------------------------
# Service discovery
# ---------------------------------------------------------------------------
SERVICE_PATH=
SERVICE_APP=

# DocType schema sync at startup: migrate | create
DOCTYPE_SYNC_MODE=migrate

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
FRAPPE_STREAM_LOGGING=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4317
